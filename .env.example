# Copia este archivo como .env y ajusta los valores.
# docker compose lee automáticamente el archivo .env del directorio raíz.

# Conexión JDBC desde el contenedor hacia PostgreSQL en el host
SUPERVISA_DB_URL=jdbc:postgresql://host.docker.internal:5432/supervisa
SUPERVISA_DB_USER=postgres
SUPERVISA_DB_PASSWORD=postgres

# ============================================================
# GECOR - base de usuarios, roles y permisos granulares
# Ahi vive a que secretaria pertenece cada persona y que puede ver.
# Con GECOR_ENABLED=false el acceso queda abierto para todos los autenticados.
# ============================================================
GECOR_ENABLED=false
GECOR_DB_URL=jdbc:postgresql://host.docker.internal:5432/gecor
GECOR_DB_USER=postgres
GECOR_DB_PASSWORD=postgres
# Al arrancar se crea la base si no existe y se aplican las migraciones Flyway.
# El usuario de arriba necesita el privilegio CREATEDB; con false se asume que la base ya existe.
GECOR_CREAR_BASE=true
# Bootstrap del administrador: correos y nombres separados por coma. Quien coincida
# recibe el rol ADMIN en su primer ingreso si todavia no tiene rol asignado.
GECOR_ADMIN_CORREOS=fabio.santos@cundinamarca.gov.co
GECOR_ADMIN_NOMBRES=FABIO ANDRES SANTOS SANABRIA

# Conexión de Debezium (CDC) hacia PostgreSQL
SUPERVISA_CDC_HOST=host.docker.internal
SUPERVISA_CDC_PORT=5432
SUPERVISA_CDC_USER=postgres
SUPERVISA_CDC_PASSWORD=postgres
SUPERVISA_CDC_DB=supervisa
SUPERVISA_CDC_ENABLED=true
SUPERVISA_CDC_SNAPSHOT_MODE=never

# Puertos publicados en el host
FRONTEND_PORT=3000
BACKEND_PORT=8080

# ============================================================
# KEYCLOAK - Login con doble factor (OpenID Connect + OTP)
# Copia los valores de tu realm/client en Keycloak.
# El client debe ser PUBLICO (Client authentication = off) para usar PKCE
# desde el navegador; si activas el secreto, no se puede usar en una SPA.
# ============================================================
# Backend: API como OAuth2 Resource Server (valida el JWT en /api/** y /ws/cdc).
AUTH_ENABLED=true
KEYCLOAK_ISSUER_URI=https://iamqa.cundinamarca.gov.co/realms/TU_REALM
KEYCLOAK_JWKS_URI=https://iamqa.cundinamarca.gov.co/realms/TU_REALM/protocol/openid-connect/certs

# El servicio route-fixer usa KEYCLOAK_ISSUER_URI para garantizar que los
# contenedores alcancen el Keycloak. No requiere configuracion adicional:
# solo se activa si Docker asigna a alguna red bridge una subred que choque
# con la red corporativa del Keycloak (por ejemplo 172.20.0.0/16).

# Frontend: se inyectan en /config.js al arrancar el contenedor (sin reconstruir).
VITE_API_URL=
VITE_ENABLE_AUTH=true
VITE_KEYCLOAK_BASE_URL=https://iamqa.cundinamarca.gov.co
VITE_KEYCLOAK_REALM=TU_REALM
VITE_KEYCLOAK_CLIENT_ID=TU_CLIENT_ID
# Deben coincidir con las "Valid redirect URIs" del client en Keycloak.
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:3000/callback
VITE_KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
VITE_KEYCLOAK_RESPONSE_TYPE=code
VITE_KEYCLOAK_SCOPE=openid profile email
# Opcional: endpoint de intercambio codigo->token. Por defecto es el mismo
# origen + /oidc/token (proxy de nginx que evita la validacion literal de
# Origin que hace Keycloak contra "Web origins" del client).
# VITE_KEYCLOAK_TOKEN_ENDPOINT=http://localhost:3000/oidc/token
